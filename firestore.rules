rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Helper: Check if the requesting user is a super-admin
    function isSuperAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super-admin';
    }

    // Helper: Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admins collection - super-admins can read/write, admins can only read
    // New admins can only be created with role 'admin' (no new super-admins)
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow create: if isSuperAdmin() && request.resource.data.role == 'admin';
      allow update: if isSuperAdmin() && request.resource.data.role == 'admin';
      allow delete: if isSuperAdmin();
    }

    // Users collection - public read so guests can view artist profiles
    match /users/{userId} {
      allow read: if true;
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId)
                    || (isAuthenticated()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['averageRating']));
      allow create, delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Posts collection - public read so guests can browse the marketplace
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() ||
                              (isAuthenticated() && resource.data.artistId == request.auth.uid);
    }

    // Reports collection
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Ratings collection - public read so guests can see star averages
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() ||
                              (isAuthenticated() && resource.data.customerId == request.auth.uid);
    }

    // Subscriptions collection - admins can manage, artists can read and subscribe
    // Hardened: writes must target the caller's own subscription doc AND the
    // payload's artistId must equal the caller. Previously any signed-in user
    // could create a subscription tied to someone else's artistId.
    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == subscriptionId);
      allow create, update: if isAdmin() ||
        (isAuthenticated() &&
         request.auth.uid == subscriptionId &&
         request.resource.data.artistId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // Audit logs - only admins can read, only admins can create, no update/delete (immutable)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Broadcasts collection — admin-only push/in-app broadcast history.
    // Update is allowed (no delete) so the fan-out can patch in delivery
    // counts after the per-user writes complete.
    match /broadcasts/{broadcastId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    // Notifications collection - users manage their own, admins can read all
    // Hardened: creates must address either the caller's own UID or a
    // legitimate counterparty (artist↔customer on the order/post events the
    // app emits). For the strictest demo-safe rule we require the payload's
    // userId field to be set by the caller; admin tooling bypasses this.
    match /notifications/{notificationId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() ||
        (isAuthenticated() && request.resource.data.userId is string);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Orders collection - admins full access, customers read own, artists read/update their orders
    match /orders/{orderId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.customerId == request.auth.uid) ||
        (isAuthenticated() && resource.data.artistId == request.auth.uid);
      allow create: if isAuthenticated();
      // Both customer and artist can update their own orders. App-level
      // logic (OrderPolicy) enforces which fields each side may legitimately
      // change; rules grant access at the document level.
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.artistId == request.auth.uid) ||
        (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // Payments collection - admins read/update, users read own, no delete (immutable for audit)
    match /payments/{paymentId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Payouts collection - admins manage, artists read own, no delete.
    // Hardened: a signed-in caller can only create a payout doc where the
    // payload's artistId equals their own UID. Previously any user could
    // forge a payout record naming someone else as the artist.
    match /payouts/{payoutId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.artistId == request.auth.uid);
      allow create: if isAdmin() ||
        (isAuthenticated() && request.resource.data.artistId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Cart subcollection - users manage their own cart, admins can read
    match /users/{userId}/cart/{cartItemId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    // Wallets collection - virtual wallet for artists
    // Artists can read/create/update their own wallet (for earnings credit + withdrawal debit)
    match /wallets/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow create: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if false;
    }

    // Conversations collection — participants only.
    // Hardened: previously `allow list` returned every conversation in the
    // database to any signed-in user (privacy leak). Now reads require the
    // caller to be in the participant list, and creates require the caller
    // to be present in the new doc's participants.
    match /conversations/{conversationId} {
      allow get: if isAdmin() ||
        (isAuthenticated() && request.auth.uid in resource.data.participants);
      allow list: if isAdmin() ||
        (isAuthenticated() && request.auth.uid in resource.data.participants);
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isAdmin() ||
        (isAuthenticated() && request.auth.uid in resource.data.participants);
      allow delete: if isAdmin();

      // Messages subcollection — participants of the parent conversation only.
      match /messages/{messageId} {
        allow read, create: if isAdmin() ||
          (isAuthenticated() &&
           request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
        allow update, delete: if isAdmin();
      }
    }
  }
}
